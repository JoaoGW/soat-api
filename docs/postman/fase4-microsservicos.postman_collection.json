  "item": [
    {
      "name": "1. Autenticação",
      "item": [
        {
          "name": "Login administrativo (OS)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{osBaseUrl}}/auth/login",
              "host": [
                "{{osBaseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Token administrativo. O Execution aceita JWT administrativo assinado com o mesmo JWT_SECRET; o token de cliente vem da Auth Function (CPF)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.accessToken) { pm.collectionVariables.set('token', json.accessToken); pm.collectionVariables.set('executionToken', json.accessToken); }"
                ]
              }
            }
          ]
        }
      ]
    },
