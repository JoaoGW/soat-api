{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://soat.example/contracts/messages/billing.quote-approved.v1.schema.json",
  "allOf": [
    {
      "$ref": "https://soat.example/contracts/messages/envelope.v1.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "billing.quote-approved.v1"
        },
        "producer": {
          "const": "soat-billing-service"
        },
        "data": {
          "type": "object",
          "required": [
            "quoteId",
            "quoteVersion",
            "clientId"
          ],
          "properties": {
            "quoteId": {
              "type": "string",
              "minLength": 1
            },
            "quoteVersion": {
              "type": "integer",
              "minimum": 1
            },
            "clientId": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  ]
}
