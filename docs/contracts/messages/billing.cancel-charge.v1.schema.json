{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://soat.example/contracts/messages/billing.cancel-charge.v1.schema.json",
  "allOf": [
    {
      "$ref": "https://soat.example/contracts/messages/envelope.v1.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "billing.cancel-charge.v1"
        },
        "producer": {
          "const": "soat-os-service"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chargeId",
            "reservationId",
            "cancelOperationId",
            "cancelEventId"
          ],
          "properties": {
            "chargeId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,128}$"
            },
            "reservationId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,128}$"
            },
            "cancelOperationId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,128}$"
            },
            "cancelEventId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]{1,128}$"
            }
          }
        }
      }
    }
  ]
}
