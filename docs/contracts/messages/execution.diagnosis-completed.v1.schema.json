{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://soat.example/contracts/messages/execution.diagnosis-completed.v1.schema.json",
  "allOf": [
    {
      "$ref": "https://soat.example/contracts/messages/envelope.v1.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "execution.diagnosis-completed.v1"
        },
        "producer": {
          "const": "soat-execution-service"
        },
        "data": {
          "type": "object",
          "required": [
            "diagnosisId",
            "diagnosisVersion",
            "items"
          ],
          "properties": {
            "diagnosisId": {
              "type": "string",
              "minLength": 1
            },
            "diagnosisVersion": {
              "type": "integer",
              "minimum": 1
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "type": "object",
                "required": [
                  "sourceId",
                  "itemType",
                  "quantity",
                  "unitPriceInCents"
                ],
                "properties": {
                  "sourceId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "itemType": {
                    "enum": [
                      "PART",
                      "SERVICE"
                    ]
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "unitPriceInCents": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
