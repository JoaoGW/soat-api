# Database (local)
DATABASE_URL="postgresql://oficina_user:oficina_pass@postgres:5432/oficina_db"

# Postgresql
POSTGRES_USER="oficina_user"
POSTGRES_PASSWORD="oficina_pass"
POSTGRES_DB="oficina_db"

# JWT
JWT_SECRET="change-me-with-at-least-32-characters"
JWT_EXPIRES_IN="1d"
JWT_CLIENT_SECRET="change-me-with-another-at-least-32-character-secret"
JWT_CLIENT_ISSUER="soat-auth-function"
JWT_CLIENT_AUDIENCE="soat-api"
# Credencial exclusiva Function -> OS; necessário somente para habilitar a rota interna.
INTERNAL_CLIENT_LOOKUP_TOKEN="replace-with-an-exclusive-secret-at-least-32-bytes"

# Admin Rules
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH="bcrypt-hash-here"

# NODEMAIL SETTINGS
MAIL_HOST="smtp.gmail.com"
MAIL_PORT="587"
MAIL_USER="seu@email.com"
MAIL_PASS="app-password"
MAIL_FROM="oficina@sistema.com"
WEBHOOK_SECRET="change-me-with-at-least-32-characters"
WEBHOOK_TOKEN_EXPIRES_IN="24h"
APP_URL="http://localhost:3000"

# Segurança Snyk (scripts/security/run-snyk-scan.mjs)
SNYK_TOKEN="token-pessoal-snyk.io"

# Fase 4: consumidores desligados por padrão; usar banco dedicado.
ENABLE_SAGA_EVENT_CONSUMER="false"
ENABLE_SAGA_REPLAY="false"
SAGA_DATABASE_URL=""
SERVICE_BUS_NAMESPACE="example.servicebus.windows.net"
SERVICE_BUS_EVENT_TOPIC="soat.domain.events"
SERVICE_BUS_SAGA_SUBSCRIPTION="os.saga-events"
SERVICE_BUS_BILLING_QUEUE="billing.commands"
SERVICE_BUS_EXECUTION_QUEUE="execution.commands"
# Identidade de mensageria quando a ServiceAccount também usa a do Key Vault (AKS).
SERVICE_BUS_CLIENT_ID=""
# Somente kind/CI: aceita a connection string do Service Bus Emulator.
ALLOW_LOCAL_EMULATORS="false"
SERVICE_BUS_CONNECTION_STRING=""
# Chaves Ed25519 (PEM) de assinatura das mensagens da Saga.
OS_MESSAGE_PRIVATE_KEY=""
BILLING_MESSAGE_PUBLIC_KEY=""
EXECUTION_MESSAGE_PUBLIC_KEY=""
MERCADO_PAGO_EXTERNAL_POS_ID=""
ENABLE_FASE4_REGISTRY="false"
ENABLE_FASE4_OPEN="false"
ENABLE_FASE4_COMPENSATION="false"
ENABLE_FASE4_DELIVERY="false"
ENABLE_FASE4_RECOVERY="false"
ENABLE_SAGA_COMMAND_PUBLISHER="false"
ENABLE_SAGA_DEADLINE_REVIEW="false"
ENABLE_SAGA_CHARGE_CANCELLATION="false"

# Rotas legadas das Fases 1–3 (clientes/veículos/OS/peças/serviços, webhook de
# orçamento e relatórios legados). Desligadas por padrão na Fase 4.
ENABLE_LEGACY_OFICINA="false"

# Prazos da Saga (minutos). Vencidos: DIAGNOSTICO_PENDENTE, AGUARDANDO_APROVACAO e
# NA_FILA iniciam compensação; EM_EXECUCAO vai para reconciliação.
SAGA_DIAGNOSIS_DEADLINE_MINUTES="1440"
SAGA_QUEUE_DEADLINE_MINUTES="4320"
SAGA_EXECUTION_DEADLINE_MINUTES="2880"
