{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://soat.example/contracts/messages/billing.payment-confirmed.v1.schema.json",
  "allOf": [
    { "$ref": "https://soat.example/contracts/messages/envelope.v1.schema.json" },
    {
      "type": "object",
      "properties": {
        "type": { "const": "billing.payment-confirmed.v1" },
        "producer": { "const": "soat-billing-service" },
        "data": {
          "type": "object",
          "required": ["chargeId", "quoteId", "quoteVersion", "paymentId", "providerOrderId", "providerPaymentId", "amountInCents", "currency", "paidAt"],
          "properties": {
            "chargeId": { "type": "string", "minLength": 1 },
            "quoteId": { "type": "string", "minLength": 1 },
            "quoteVersion": { "type": "integer", "minimum": 1 },
            "paymentId": { "type": "string", "minLength": 1 },
            "providerOrderId": { "type": "string", "minLength": 1 },
            "providerPaymentId": { "type": "string", "minLength": 1 },
            "amountInCents": { "type": "integer", "minimum": 1 },
            "currency": { "const": "BRL" },
            "paidAt": { "type": "string", "format": "date-time" }
          }
        }
      }
    }
  ]
}
