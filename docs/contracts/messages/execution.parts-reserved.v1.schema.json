{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://soat.example/contracts/messages/execution.parts-reserved.v1.schema.json",
  "allOf": [
    { "$ref": "https://soat.example/contracts/messages/envelope.v1.schema.json" },
    { "type": "object", "properties": {
      "type": { "const": "execution.parts-reserved.v1" },
      "producer": { "const": "soat-execution-service" },
      "data": { "type": "object", "required": ["quoteId", "quoteVersion", "reservationId", "deadline", "items"], "properties": {
        "quoteId": { "type": "string", "minLength": 1 },
        "quoteVersion": { "type": "integer", "minimum": 1 },
        "reservationId": { "type": "string", "minLength": 1 },
        "deadline": { "type": "string", "format": "date-time" },
        "items": { "type": "array", "maxItems": 20, "items": { "type": "object", "required": ["sku", "quantity"], "properties": { "sku": { "type": "string", "minLength": 1 }, "quantity": { "type": "integer", "minimum": 1 } } } }
      } }
    } }
  ]
}
