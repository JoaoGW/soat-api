{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://soat.example/contracts/messages/billing.generate-quote.v1.schema.json",
  "allOf": [
    { "$ref": "https://soat.example/contracts/messages/envelope.v1.schema.json" },
    {
      "type": "object",
      "properties": {
        "type": { "const": "billing.generate-quote.v1" },
        "producer": { "const": "soat-os-service" },
        "data": {
          "type": "object",
          "required": ["clienteId", "contato", "diagnosisId", "diagnosisVersion", "items", "expiresAt"],
          "properties": {
            "clienteId": { "type": "string", "minLength": 1 },
            "contato": { "type": "string", "minLength": 1 },
            "diagnosisId": { "type": "string", "minLength": 1 },
            "diagnosisVersion": { "type": "integer", "minimum": 1 },
            "expiresAt": { "type": "string", "format": "date-time" },
            "items": {
              "type": "array", "minItems": 1,
              "items": {
                "type": "object", "required": ["sourceId", "itemType", "quantity", "unitPriceInCents"],
                "properties": {
                  "sourceId": { "type": "string", "minLength": 1 },
                  "itemType": { "enum": ["PART", "SERVICE"] },
                  "quantity": { "type": "integer", "minimum": 1 },
                  "unitPriceInCents": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        }
      }
    }
  ]
}
