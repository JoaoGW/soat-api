{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://soat.example/contracts/messages/billing.quote-failed.v1.schema.json",
  "allOf": [
    { "$ref": "https://soat.example/contracts/messages/envelope.v1.schema.json" },
    { "type": "object", "properties": {
      "type": { "const": "billing.quote-failed.v1" },
      "producer": { "const": "soat-billing-service" },
      "data": { "type": "object", "required": ["reasonCode", "diagnosisId", "diagnosisVersion"], "properties": {
        "reasonCode": { "enum": ["EXPIRED", "ALREADY_EXISTS"] },
        "diagnosisId": { "type": "string", "minLength": 1 },
        "diagnosisVersion": { "type": "integer", "minimum": 1 }
      } }
    } }
  ]
}
